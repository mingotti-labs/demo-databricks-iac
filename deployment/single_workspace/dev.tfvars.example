# Non-sensitive variables template — copy to dev.tfvars and fill in
# Sensitive credentials (aws_access_key_id, aws_secret_access_key, databricks_token,
# neon_api_key, mongodbatlas_public_key, mongodbatlas_private_key) are Terraform variables
# set in the HCP Terraform workspace variable set — never written here or committed.

aws_region          = "ap-southeast-2"
environment         = "dev"
databricks_host     = "https://dbc-e3197e2d-933b.cloud.databricks.com"
mongodbatlas_org_id = "6aa49e0b17258aa1f5264490"
neon_org_id         = "org-xxxxxxxx-xxxxxxxx"

# environments: catalog + bucket name per environment. The default in variables.tf already
# matches this project (hoe-mdp-dev/tst/prd, mdp_dev/tst/prd) — override here only if needed.

# uc_external_ids: leave empty ({}) on first apply. After first apply, set from
# `terraform output uc_external_ids` and re-apply to harden each environment's IAM trust policy.
uc_external_ids = {}
